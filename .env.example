# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GitHub OAuth Application Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/github_guardian
MONGODB_DB_NAME=github_guardian

# Security & Encryption Configuration
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_base64_fernet_key_here
STATE_SECRET=your_custom_csrf_secret_salt_here

# Webhook & OAuth Base URL
APP_BASE_URL=http://localhost:8000
PORT=8000

# Optional: Admin Configuration (Telegram Numerical ID)
ADMIN_ID=1447828370

# Optional: Force Channel Subscription (comma-separated: @channel1, -100123456789|https://t.me/+link)
MUST_JOIN_CHANNELS=

# Optional: Custom Welcome Banners (comma-separated image URLs)
WELCOME_IMAGE_URLS=
